FROM docker.io/oven/bun:1.1

WORKDIR /app

COPY package.json package.json
COPY bun.lock bun.lock

RUN bun install 

COPY ./src ./src

ENV NODE_ENV=production

# Agendash serves static assets from node_modules at runtime,
# so we run with bun directly rather than compiling to a single binary.
EXPOSE 3001

CMD ["bun", "run", "src/worker.ts"]
