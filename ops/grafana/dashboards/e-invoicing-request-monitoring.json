{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Totals (selected range)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "id": 2,
      "title": "Invoices submitted",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__range]))",
          "legendFormat": "submitted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "title": "Invoices accepted",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(einvoice_invoices_accepted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__range]))",
          "legendFormat": "accepted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0 }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "title": "Success rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(einvoice_invoices_processed_total{result=\"success\",tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])) / clamp_min(sum(rate(einvoice_invoices_processed_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "success_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5,
      "title": "Processing p95",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(einvoice_invoice_processing_duration_seconds_bucket{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 2 }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "row",
      "title": "Trends",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10
    },
    {
      "id": 11,
      "title": "Invoices submitted — trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (erp_system) (rate(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval]))",
          "legendFormat": "{{erp_system}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }
      }
    },
    {
      "id": 12,
      "title": "Invoices accepted — trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum by (erp_system) (rate(einvoice_invoices_accepted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval]))",
          "legendFormat": "{{erp_system}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }
      }
    },
    {
      "id": 13,
      "title": "Success rate — trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(einvoice_invoices_processed_total{result=\"success\",tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])) / clamp_min(sum(rate(einvoice_invoices_processed_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "success rate",
          "refId": "A"
        },
        {
          "expr": "sum by (erp_system) (rate(einvoice_invoices_processed_total{result=\"failure\",tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval]))",
          "legendFormat": "failures {{erp_system}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success rate" },
            "properties": [{ "id": "unit", "value": "percentunit" }]
          }
        ]
      }
    },
    {
      "id": 14,
      "title": "Processing response time — trend",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (le) (rate(einvoice_invoice_processing_duration_seconds_bucket{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(einvoice_invoice_processing_duration_seconds_bucket{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(einvoice_invoice_processing_duration_seconds_bucket{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }
      }
    },
    {
      "id": 15,
      "title": "Submitted vs accepted (gap / backlog signal)",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h])) - sum(increase(einvoice_invoices_accepted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h]))",
          "legendFormat": "submitted - accepted (1h)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 40 } }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["e-invoicing", "request-monitoring"],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(einvoice_invoices_submitted_total, tenant_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "erp",
        "label": "Source ERP",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\"}, erp_system)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d", "90d"]
  },
  "timezone": "browser",
  "title": "E-Invoicing — Request Monitoring",
  "uid": "einvoice-request-monitoring",
  "version": 2
}
