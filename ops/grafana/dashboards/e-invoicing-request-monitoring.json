{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "title": "Business totals (selected range)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1
    },
    {
      "id": 2,
      "title": "Invoices submitted",
      "description": "Count of invoices that entered the e-invoicing app (processing started).",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "round(sum(increase(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__range])))",
          "legendFormat": "submitted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 3,
      "title": "Accepted by NRS",
      "description": "Count of invoices successfully accepted by NRS/FIRS.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "round(sum(increase(einvoice_invoices_accepted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__range])))",
          "legendFormat": "accepted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "none", "decimals": 0 }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 4,
      "title": "Success rate (NRS accepted ÷ submitted)",
      "description": "Accepted by NRS divided by invoices submitted in the selected range.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "clamp_min(round(sum(increase(einvoice_invoices_accepted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__range]))), 0) / clamp_min(round(sum(increase(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__range]))), 1)",
          "legendFormat": "success_rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5,
      "title": "Avg processing time",
      "description": "Average time from submit to NRS success or failure.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(einvoice_invoice_processing_duration_seconds_sum{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])) / clamp_min(sum(rate(einvoice_invoice_processing_duration_seconds_count{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "avg",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 1 }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" }
    },
    {
      "type": "row",
      "title": "Trends (invoice counts)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 10
    },
    {
      "id": 11,
      "title": "Invoices submitted — count per hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "round(sum by (erp_system) (increase(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h])))",
          "legendFormat": "{{erp_system}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "spanNulls": false, "stacking": { "mode": "normal", "group": "A" } }
        }
      }
    },
    {
      "id": 12,
      "title": "Accepted by NRS — count per hour",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "round(sum by (erp_system) (increase(einvoice_invoices_accepted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h])))",
          "legendFormat": "{{erp_system}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 50, "spanNulls": false, "stacking": { "mode": "normal", "group": "A" } }
        }
      }
    },
    {
      "id": 13,
      "title": "Success rate — trend (accepted ÷ submitted per hour)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "clamp_min(round(sum(increase(einvoice_invoices_accepted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h]))), 0) / clamp_min(round(sum(increase(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h]))), 1)",
          "legendFormat": "success rate",
          "refId": "A"
        },
        {
          "expr": "round(sum by (erp_system) (increase(einvoice_invoices_processed_total{result=\"failure\",tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h])))",
          "legendFormat": "failed {{erp_system}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 40, "spanNulls": false }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success rate" },
            "properties": [
              { "id": "unit", "value": "percentunit" },
              { "id": "decimals", "value": 1 },
              { "id": "custom.drawStyle", "value": "line" },
              { "id": "custom.fillOpacity", "value": 10 }
            ]
          }
        ]
      }
    },
    {
      "id": 14,
      "title": "Processing time — submit to NRS outcome",
      "description": "Average and p95 time from submit until success or failure.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(einvoice_invoice_processing_duration_seconds_sum{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])) / clamp_min(sum(rate(einvoice_invoice_processing_duration_seconds_count{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "average",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(einvoice_invoice_processing_duration_seconds_bucket{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 1, "custom": { "drawStyle": "line", "fillOpacity": 10, "spanNulls": true } }
      }
    },
    {
      "id": 15,
      "title": "Pending vs done (submitted − NRS accepted, per hour)",
      "description": "Gap between submitted and NRS-accepted counts. Includes in-flight and failed invoices.",
      "type": "timeseries",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 22 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "round(sum(increase(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h]))) - round(sum(increase(einvoice_invoices_accepted_total{tenant_id=~\"$tenant\",erp_system=~\"$erp\"}[1h])))",
          "legendFormat": "submitted − NRS accepted",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 40 }
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": ["e-invoicing", "request-monitoring", "business"],
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(einvoice_invoices_submitted_total, tenant_id)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "erp",
        "label": "Source ERP",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(einvoice_invoices_submitted_total{tenant_id=~\"$tenant\"}, erp_system)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "6h", "12h", "24h", "2d", "7d", "30d", "90d"]
  },
  "timezone": "browser",
  "title": "E-Invoicing — Request Monitoring",
  "uid": "einvoice-request-monitoring",
  "version": 3
}
